@misc{de_la_rosa_alberti_2023,
	title = {{ALBERTI}, a {Multilingual} {Domain} {Specific} {Language} {Model} for {Poetry} {Analysis}},
	url = {http://arxiv.org/abs/2307.01387},
	doi = {10.48550/arXiv.2307.01387},
	abstract = {The computational analysis of poetry is limited by the scarcity of tools to automatically analyze and scan poems. In a multilingual settings, the problem is exacerbated as scansion and rhyme systems only exist for individual languages, making comparative studies very challenging and time consuming. In this work, we present {\textbackslash}textsc\{Alberti\}, the first multilingual pre-trained large language model for poetry. Through domain-specific pre-training (DSP), we further trained multilingual BERT on a corpus of over 12 million verses from 12 languages. We evaluated its performance on two structural poetry tasks: Spanish stanza type classification, and metrical pattern prediction for Spanish, English and German. In both cases, {\textbackslash}textsc\{Alberti\} outperforms multilingual BERT and other transformers-based models of similar sizes, and even achieves state-of-the-art results for German when compared to rule-based systems, demonstrating the feasibility and effectiveness of DSP in the poetry domain.},
	urldate = {2024-03-17},
