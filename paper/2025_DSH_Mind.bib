@article{porter_ai-generated_2024,
	title = {{AI}-generated poetry is indistinguishable from human-written poetry and is rated more favorably},
	volume = {14},
	copyright = {2024 The Author(s)},
	issn = {2045-2322},
	url = {https://www.nature.com/articles/s41598-024-76900-1},
	doi = {10.1038/s41598-024-76900-1},
	abstract = {As AI-generated text continues to evolve, distinguishing it from human-authored content has become increasingly difficult. This study examined whether non-expert readers could reliably differentiate between AI-generated poems and those written by well-known human poets. We conducted two experiments with non-expert poetry readers and found that participants performed below chance levels in identifying AI-generated poems (46.6\% accuracy, χ2(1, N = 16,340) = 75.13, p {\textless} 0.0001). Notably, participants were more likely to judge AI-generated poems as human-authored than actual human-authored poems (χ2(2, N = 16,340) = 247.04, p {\textless} 0.0001). We found that AI-generated poems were rated more favorably in qualities such as rhythm and beauty, and that this contributed to their mistaken identification as human-authored. Our findings suggest that participants employed shared yet flawed heuristics to differentiate AI from human poetry: the simplicity of AI-generated poems may be easier for non-experts to understand, leading them to prefer AI-generated poetry and misinterpret the complexity of human poems as incoherence generated by AI.},
	language = {en},
	number = {1},
	urldate = {2024-12-16},
	journal = {Scientific Reports},
	author = {Porter, Brian and Machery, Edouard},
	month = nov,
	year = {2024},
	note = {Publisher: Nature Publishing Group},
	keywords = {Psychology, Human behaviour, LLMs},
	pages = {26133},
	file = {Full Text PDF:/home/artjoms/Zotero/storage/65PT5Z4Q/Porter and Machery - 2024 - AI-generated poetry is indistinguishable from huma.pdf:application/pdf},
}

@book{hall_meter_2011,
	address = {Athens},
	title = {Meter {Matters}: {Verse} {Cultures} of the {Long} {Nineteenth} {Century}},
	isbn = {978-0-8214-1968-7},
	shorttitle = {Meter {Matters}},
	abstract = {Across the nineteenth century, meter matteredin more ways and to more people than we might well appreciate today. For the periods poets, metrical matters were a source of inspiration and often vehement debate. And the many readers, teachers, and pupils encountered meter and related topics in both institutional and popular forms. The ten essays in Meter Matters showcase the range of metrical practice of poets from Wordsworth and Byron to Hopkins, Swinburne, and Tennyson; at the same time, the contributors bring into focus some of the metrical theorizing that shaped poetic thinking and responses to it throughout the nineteenth century. Paying close attention to the historical contours of Romantic and Victorian meters, as well as to the minute workings of the verse line, Meter Matters presents a fresh perspective on a subject that figured significantly in the centurys literature, and in its culture.},
	language = {English},
	publisher = {Ohio University Press},
	editor = {Hall, Jason David},
	year = {2011},
}

@article{tarlinskaja_rhythm-morphology-syntax-rhythm_1984,
	title = {Rhythm-{Morphology}-{Syntax}-{Rhythm}: {In} memory of {Roman} {Jakobson}},
	volume = {18},
	issn = {0039-4238},
	shorttitle = {Rhythm-{Morphology}-{Syntax}-{Rhythm}},
	url = {https://www.jstor.org/stable/42945477},
	abstract = {Scholars studying verse usually concentrate either on its specific, metrical/rhythmical properties, or deal with more general levels of the text structure: grammatical; lexical and semantic. They do not connect the higher levels of verse with its form. This paper describes an attempt to find a link between rhythmical (accentual and word boundary) line forms of English verse, and the grammatical (part-of-speech, syntactic) structures that usually fill these forms. The results of the analysis, based on a wide range of verse and prose, show that there is a reciprocal relationship between rhythmical and grammatical line structures: favored rhythmical line types call forth particular part-of-speech and syntactic patterns, while particular syntactic patterns, favored in an epoch, call forth particular rhythmic line types. The connecting link between verse rhythm and line syntax is morphology: words of different parts of speech have dissimilar rhythmical structures; this fact is made use of in verse. The rhythmical differences between masculine, feminine and dactylic endings of different parts of speech shapes the rhythmics of verse; the fact that different rhythmical endings are typical of different parts of speech shapes the syntax of verse ("grammar of poetry"). The part-of-speech partiality of different rhythmical types of words sheds some light on the expressive function of word boundaries ("poetry of grammar").},
	number = {1},
	urldate = {2025-08-26},
	journal = {Style},
	author = {Tarlinskaja, Marina},
	year = {1984},
	note = {Publisher: Penn State University Press},
	pages = {1--26},
	file = {JSTOR Full Text PDF:/home/artjoms/Zotero/storage/7Q5E2DLL/Tarlinskaja - 1984 - Rhythm-Morphology-Syntax-Rhythm In memory of Roma.pdf:application/pdf},
}

